# ── 필수 ──────────────────────────────────────────────
# Anthropic 콘솔(console.anthropic.com)에서 발급
ANTHROPIC_API_KEY=

# ── 사이트 ────────────────────────────────────────────
PORT=3000
SITE_NAME=캐릭터톡
SITE_URL=http://localhost:3000
DB_PATH=data/chartalk.db
# 관리자 대시보드(/admin)를 볼 계정. 비우면 1번으로 가입한 계정이 관리자입니다.
ADMIN_EMAILS=

# ── 결제 (토스페이먼츠) ───────────────────────────────
# 비워두면 모의 결제 모드로 동작합니다(실제 결제 없음).
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 수익 설정 ─────────────────────────────────────────
MONTHLY_GOAL_KRW=300000
USD_KRW=1380

LITE_PRICE_KRW=9900
PRO_PRICE_KRW=19900

# 플랜별 월 API 원가 상한(원). 이 값이 마진을 보장합니다.
FREE_COST_CAP_KRW=500
LITE_COST_CAP_KRW=3000
PRO_COST_CAP_KRW=7000

# 충전팩
TOPUP_SMALL_KRW=3900
TOPUP_SMALL_CAP_KRW=1200
TOPUP_LARGE_KRW=9900
TOPUP_LARGE_CAP_KRW=3500

# 플랜별 모델. 원가와 몰입감의 균형을 여기서 조절합니다.
MODEL_FREE=claude-haiku-4-5
MODEL_LITE=claude-sonnet-5
MODEL_PRO=claude-opus-5
